{
  "name": "@appport/fx",
  "version": "0.1.2",
  "description": "Embed fx agents and terminals in JavaScript hosts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkendel1/3fx.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/rkendel1/3fx/tree/main/sdk#readme",
  "bugs": "https://github.com/rkendel1/3fx/issues",
  "scripts": {
    "test:node-wasm": "node tests/test-node-wasm.mjs",
    "test:node-napi": "node tests/test-node-napi.mjs",
    "test:browser-wasm": "node tests/test-browser-wasm.mjs",
    "test:packed-consumer": "node tests/test-packed-consumer.mjs",
    "test:direct-agent": "node tests/test-direct-agent.mjs && node tests/test-direct-agent-provider.mjs",
    "test:live-ollama": "node tests/test-live-ollama.mjs",
    "test:live-ollama-agent": "node tests/test-live-ollama-agent.mjs"
  },
  "exports": {
    ".": {
      "node": {
        "import": "./node.js",
        "require": "./node.cjs"
      },
      "browser": "./browser.js",
      "default": "./browser.js"
    },
    "./node": {
      "import": "./node.js",
      "require": "./node.cjs"
    },
    "./browser": "./browser.js",
    "./wasm": "./fx-sdk.js",
    "./mcp": "./mcp.js",
    "./skills": "./skills.js",
    "./skills/node": "./skills-node.js"
  },
  "files": [
    "browser.js",
    "node.js",
    "node.cjs",
    "fx-sdk.js",
    "wasm-module.js",
    "core-output.js",
    "direct-agent.js",
    "mcp.js",
    "skills.js",
    "skills-node.js",
    "fx-core.wasm",
    "fx-term.wasm",
    "*.node",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
