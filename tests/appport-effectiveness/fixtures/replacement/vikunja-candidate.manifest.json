 "conformance": 1,
 "extensions": [
  "appport.integration/1"
 ],
 "attributes": {
  "appport.integration/1": {
   "capabilities": {
    "vikunja.projects.list@1": {
     "purpose": "List projects visible to the caller.",
     "authority": "urn:appport:vikunja",
     "access": [
      {
       "resource": "urn:appport:vikunja:projects",
       "mode": "reads"
      }
     ],
     "approval": {
      "required": false
     }
    },
    "vikunja.tasks.setdone@1": {
     "purpose": "Set a task's done flag.",
     "authority": "urn:appport:vikunja",
     "effects": [
      {
       "type": "urn:appport:vikunja#task-done-changed",
       "description": "The task's done flag (and Vikunja's done_at) change."
      }
     ],
     "verify": [
      {
       "id": "task-done-stored",
       "kind": "state",
       "via": {
        "capability": "vikunja.tasks.get",
        "version": 1,
        "input": {
         "id": {
          "$input": "/id"
         }
        }
       },
       "expect": [
        {
         "at": "/done",
         "equals": {
          "$input": "/done"
         }
        }
       ]
      }
     ],
     "access": [
      {
       "resource": "urn:appport:vikunja:tasks",
       "mode": "changes",
       "operations": [
        "update"
       ]
      }
     ],
     "approval": {
      "required": false
     },
     "failures": [
      {
       "code": "FORBIDDEN",
       "retry": "unsafe",
       "effect": "none",
       "description": "Vikunja refused: the caller may not update this task."
      },
      {
       "code": "NOT_FOUND",
       "retry": "unsafe",
       "effect": "none"
      },
      {
       "code": "INTERNAL_ERROR",
       "retry": "after-verification",
       "effect": "unknown",
       "description": "Read the task before trying again."
      }
     ]
    }
   },
   "resources": [
    {
     "id": "urn:appport:vikunja:projects",
     "kind": "collection",
     "owner": "self",
     "description": "Projects stored by this Vikunja instance."
    },
    {
     "id": "urn:appport:vikunja:tasks",
     "kind": "collection",
     "owner": "self",
     "description": "Tasks stored by this Vikunja instance."
    }
   ]
  }
 }
