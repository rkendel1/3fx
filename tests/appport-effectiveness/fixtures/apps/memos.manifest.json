       "additionalProperties": false,
       "required": [
        "name",
        "creator",
        "visibility",
        "state",
        "pinned",
        "tags",
        "snippet",
        "createTime",
        "updateTime"
       ]
      }
     },
     "nextPageToken": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
