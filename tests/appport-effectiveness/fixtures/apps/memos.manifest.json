  {
   "name": "memos.get",
   "versions": [
    1
   ],
   "latestVersion": 1,
   "description": "Retrieve one memo, including its content, if Memos lets the caller see it.",
   "kind": "request",
   "inputSchema": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "Memo resource name, e.g. memos/AbC123",
      "pattern": "^memos/[A-Za-z0-9_-]{1,64}$"
     }
    },
    "additionalProperties": false,
    "required": [
     "name"
    ]
   },
   "outputSchema": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "creator": {
      "type": "string",
      "description": "users/<username>"
     },
     "visibility": {
      "type": "string",
      "enum": [
       "PRIVATE",
       "PROTECTED",
       "PUBLIC"
      ]
     },
     "state": {
      "type": "string"
     },
     "pinned": {
      "type": "boolean"
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "snippet": {
      "type": "string"
     },
     "createTime": {
      "type": "string"
     },
     "updateTime": {
      "type": "string"
     },
     "content": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "name",
     "creator",
     "visibility",
     "state",
     "pinned",
     "tags",
     "snippet",
     "createTime",
     "updateTime",
     "content"
    ]
   },
   "authorization": [
    "memos.read"
   ],
   "effect": "observation",
   "authorizationContract": {
    "required": true,
    "scopes": [
     "memos.read"
    ]
   },
   "authorizationVersion": 1,
   "idempotency": "unsupported",
   "concurrency": {
    "mode": "parallel"
   },
   "definitions": [
    {
